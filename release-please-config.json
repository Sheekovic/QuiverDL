{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "draft-pull-request": true,
  "include-component-in-tag": false,
  "skip-github-release": true,
  "packages": {
    ".": {
      "package-name": "QuiverDL",
      "version-file": "version.txt",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/quiver-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/quiver-native-host/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package-lock.json",
          "jsonpath": "$['packages']['']['version']"
        },
        {
          "type": "json",
          "path": "extensions/chromium/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "extensions/firefox/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "snap/snapcraft.yaml",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
