{
  "manifest_version": 3,
  "name": "QuiverDL Browser Companion",
  "version": "0.1.0",
  "description": "Send explicitly selected downloads to QuiverDL.",
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "storage"],
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "QuiverDL" },
  "browser_specific_settings": {
    "gecko": { "id": "quiverdl@quiverdl.app", "strict_min_version": "128.0" }
  }
}
